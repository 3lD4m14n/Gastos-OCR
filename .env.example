# Copiar a .env solo si hace falta cambiar algo: docker-compose ya trae estos valores.
# Son credenciales de desarrollo local, nunca de AWS.
POSTGRES_USER=gastos
POSTGRES_PASSWORD=gastos_local
POSTGRES_DB=gastos
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=gastos-tickets-local
# La Región del proyecto en AWS. Boto3 también la usa para firmar contra el S3 local.
AWS_REGION=us-east-2
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Para ejecutar la API o scripts fuera de Docker (por ejemplo, api/scripts/smoke_s3.py).
DATABASE_URL=postgresql+psycopg://gastos:gastos_local@localhost:5432/gastos
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
